# Reduce build context size
.git
.gitignore
.vscode
.DS_Store

# Node artifacts
node_modules
app/node_modules
dist
app/dist
coverage
.cache

# Env files
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-error.log*
